# Kullanilacak saglayici: "anthropic" (Claude, urun icin onerilir) veya "gemini" (ucretsiz test icin)
AI_PROVIDER=gemini

ANTHROPIC_API_KEY=sk-ant-...buraya-kendi-anahtarini-koy
ANTHROPIC_WORKSPACE_ID=wrkspc_...gerekirse-buraya-ekle

# aistudio.google.com adresinden ucretsiz alinir, kart bilgisi istemez
GEMINI_API_KEY=buraya-gemini-anahtarini-koy

# --- E-posta gonderimi (dogrulama + sifre sifirlama linkleri icin) ---
# Bos birakilirsa e-postalar GONDERILMEZ, sadece backend terminaline yazilir.
# Gmail kullanacaksan: Google Hesabi -> Guvenlik -> 2 Adimli Dogrulama (acik olmali)
# -> "Uygulama sifreleri" -> yeni bir uygulama sifresi olustur (16 haneli, boslu).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seninadresin@gmail.com
SMTP_PASS=uygulama-sifresi-buraya
FROM_EMAIL=seninadresin@gmail.com

# Dogrulama/sifirlama e-postalarindaki linklerin gidecegi site adresi.
# Yerelde test ederken degistirme, canliya alinca gercek domain'in ile guncelle.
FRONTEND_URL=http://localhost:3000

# --- Nesne depolama (Backblaze B2, Cloudflare R2 veya herhangi bir S3-uyumlu servis) ---
# Bos birakilirsa dosyalar sunucu diskinde saklanir (gelistirme ortami icin yeterli).
#
# Backblaze B2 icin ornek degerler:
#   STORAGE_ENDPOINT   = https://s3.us-west-004.backblazeb2.com   (bucket ayarlarinda gosterilir)
#   STORAGE_PUBLIC_URL = https://f004.backblazeb2.com/file/bucket-adin
#
# Cloudflare R2 icin ornek degerler:
#   STORAGE_ENDPOINT   = https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_PUBLIC_URL = https://pub-xxxx.r2.dev
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=
