# Postgres baglanti adresi - ZORUNLU, backend bu olmadan hic baslamaz.
# Yerelde: postgresql://kullanici:sifre@localhost:5432/klipster
# Railway'de: bir Postgres servisi eklendiginde otomatik saglanir (Variables
# sekmesinde "Add variable reference" ile o servise baglanabilirsin).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/klipster

# Kullanilacak saglayici: "anthropic" (Claude, urun icin onerilir) veya "gemini" (ucretsiz test icin)
AI_PROVIDER=gemini

ANTHROPIC_API_KEY=sk-ant-...buraya-kendi-anahtarini-koy
ANTHROPIC_WORKSPACE_ID=wrkspc_...gerekirse-buraya-ekle

# aistudio.google.com adresinden ucretsiz alinir, kart bilgisi istemez
GEMINI_API_KEY=buraya-gemini-anahtarini-koy

# --- Konusma tanima (transkript) ---
# GROQ_API_KEY tanimliysa transkript Groq'un ucretsiz whisper-large-v3 API'si
# uzerinden yapilir - console.groq.com adresinden kart bilgisi istemeden
# alinir. Bu, yerel faster-whisper modeline gore COK daha dogru sonuc verir
# (ozellikle Turkce'de) ve Railway'in sinirli CPU'sunu da yormaz - GUCLU BIR
# SEKILDE ONERILIR. Bos birakilirsa asagidaki yerel modele dusulur.
GROQ_API_KEY=

# GROQ_API_KEY bos birakilirsa kullanilan yerel faster-whisper modeli - kucuk
# modeller (base) hizli ama kelime atlama/yanlis tanima ihtimali daha yuksek,
# buyuk modeller (small, medium) daha dogru ama daha yavas/daha fazla RAM ister.
WHISPER_MODEL=base

# --- Linkten video indirme (YouTube vb.) ---
# YouTube, sunucu/veri merkezi IP'lerinden (Railway gibi) gelen, oturum
# acmamis istekleri "bot" sayip engelleyebiliyor ("Sign in to confirm
# you're not a bot" hatasi) - bu durumda linkten yukleme calismaz. Cozum:
# gercek bir YouTube oturumunun cerezlerini (cookies) buraya vermek.
#
# Nasil alinir:
#   1) Tercihen ANA hesabin DEGIL, yedek/ikincil bir Google hesabi kullan.
#   2) Tarayiciya "Get cookies.txt LOCALLY" eklentisini kur, o hesapla
#      youtube.com'a giris yap, youtube.com icin cookies.txt indir.
#   3) Base64'e cevir: `base64 -i cookies.txt | pbcopy` (Mac) veya
#      `base64 -w0 cookies.txt` (Linux) - sonucu buraya yapistir.
# Bos birakilirsa cerezsiz denenir, YouTube'un bot korumasina takilabilir.
YOUTUBE_COOKIES_B64=

# --- E-posta gonderimi (dogrulama + sifre sifirlama linkleri icin) ---
# Bos birakilirsa e-postalar GONDERILMEZ, sadece backend terminaline yazilir.
# Gmail kullanacaksan: Google Hesabi -> Guvenlik -> 2 Adimli Dogrulama (acik olmali)
# -> "Uygulama sifreleri" -> yeni bir uygulama sifresi olustur (16 haneli, boslu).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seninadresin@gmail.com
SMTP_PASS=uygulama-sifresi-buraya
FROM_EMAIL=seninadresin@gmail.com

# Dogrulama/sifirlama e-postalarindaki linklerin gidecegi site adresi.
# Yerelde test ederken degistirme, canliya alinca gercek domain'in ile guncelle.
FRONTEND_URL=http://localhost:3000

# Bu backend'in KENDI disaridan erisilebilir adresi - iyzico odeme sonrasi
# kullaniciyi buraya (/api/payments/callback) geri gonderiyor. Railway'de
# servisin "Public Networking" adresi (https://....up.railway.app veya
# api.klipster.com.tr gibi ozel domain'in).
BACKEND_URL=http://localhost:8000

# --- Odeme / Abonelik (iyzico) ---
# iyzico.com'da hesap acip (once Sandbox anahtarlariyla test edebilirsin,
# hesap onayi beklemeden hemen kullanilabilir) Ayarlar -> API Bilgilerim'den
# alinir. Bos birakilirsa odeme sistemi devre disi kalir (fiyatlandirma
# sayfasi "yapilandirilmadi" hatasi doner).
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox: sandbox-api.iyzipay.com , Canli: api.iyzipay.com
IYZICO_BASE_URL=sandbox-api.iyzipay.com

# backend/scripts/setup_iyzico_products.py BIR KERE calistirilarak Yaratici
# ve Ajans planlari icin olusturulan fiyatlandirma plani referans kodlari.
IYZICO_YARATICI_PLAN_CODE=
IYZICO_AJANS_PLAN_CODE=

# --- Nesne depolama (Backblaze B2, Cloudflare R2 veya herhangi bir S3-uyumlu servis) ---
# Bos birakilirsa dosyalar sunucu diskinde saklanir (gelistirme ortami icin yeterli).
#
# Backblaze B2 icin ornek degerler:
#   STORAGE_ENDPOINT   = https://s3.us-west-004.backblazeb2.com   (bucket ayarlarinda gosterilir)
#   STORAGE_PUBLIC_URL = https://f004.backblazeb2.com/file/bucket-adin
#
# Cloudflare R2 icin ornek degerler:
#   STORAGE_ENDPOINT   = https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_PUBLIC_URL = https://pub-xxxx.r2.dev
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=
